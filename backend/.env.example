# Copy to .env for local development (npm run dev). On Render, set these in the dashboard (Environment tab).

# Required for the AI trip planner / Ask-the-Place / translator
GROQ_API_KEY=

# Optional fallback AI provider (used if Groq fails or is not set)
GEMINI_API_KEY=

# Optional overrides
# GROQ_MODEL=
# EXTRA_ALLOWED_ORIGINS=https://your-web-app.example.com

# Optional: folder for the SQLite database (users, sessions, favourites, itineraries).
# Defaults to ./data. On Render use a persistent disk path such as /var/data.
# DATA_DIR=

# Render sets PORT itself; only needed locally.
PORT=3001
