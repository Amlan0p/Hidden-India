<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen theme shown while the app is cold-starting.
         androidx.core.splashscreen.SplashScreen reads this via installSplashScreen()
         and then automatically switches the activity to postSplashScreenTheme (AppTheme). -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FBF9F8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
